---
import Base from '../layouts/Base.astro';
import { homeCounts, protocolsIn } from '../lib/counts';
import { getData } from '../lib/data';
import { CONTRIBUTING_URL, REPO_URL } from '../lib/site';
import { url } from '../lib/url';

const { projects, csms } = getData();
const counts = homeCounts(projects, csms);
const protocols = protocolsIn(projects);
const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`;

const sections = [
  {
    href: url('specifications/'),
    meta: plural(counts.protocols, 'protocol'),
    title: 'Specifications',
    text: 'Official documents, schemas and reference links for each protocol, as maintained in the README.',
  },
  {
    href: url('projects/'),
    meta: `${counts.selected} selected · ${counts.listed} listed`,
    title: 'Developer Tools',
    text: 'Servers, simulators, libraries and test suites. Filter by protocol, category, language, host and curation state.',
  },
  {
    href: url('csms/'),
    meta: `${plural(counts.csmsProducts, 'product')} · ${plural(counts.ocaCertificates, 'OCA certificate')}`,
    title: 'CSMS Directory',
    text: 'Charging station management systems, with certified and vendor-documented features kept apart.',
  },
  {
    href: url('regulations/'),
    meta: 'Editorial',
    title: 'Regulations',
    text: 'Hand-maintained prose and official citations, rendered from the README rather than copied.',
  },
];

const steps = [
  { step: '1 · Canonical', title: 'Curated CSVs and README', text: 'Reviewed through pull requests on GitHub.' },
  { step: '2 · Export', title: 'Versioned public JSON', text: 'Deterministic, generated from the canonical files.' },
  { step: '3 · Build', title: 'Static pages', text: 'Built offline from the export; no network calls.' },
];
---

<Base description="Open tools and references for EV charging protocols: a searchable reading interface over the awesome-ev-charging catalogue of OCPP, OCPI, ISO 15118 and related projects, specifications and CSMS products.">
  <div class="container">
    <section class="hero">
      <p class="eyebrow">A reading interface for the awesome list</p>
      <h1>Open tools and references for EV charging protocols.</h1>
      <p class="lead">
        Browse the curated catalogue of OCPP, OCPI, ISO 15118, OICP, eMI³ and Eichrecht projects, the
        specifications they implement, and a directory of charging station management systems. Every
        record comes from the <a href={REPO_URL}>public catalogue on GitHub</a>; the README stays the
        source of truth.
      </p>
      <div class="actions">
        <a class="button button-primary" href={url('projects/')}>Browse developer tools</a>
        <a class="button button-secondary" href={url('csms/')}>Open the CSMS directory</a>
      </div>
    </section>

    <section aria-label="Sections" class="cards">
      {
        sections.map((s) => (
          <a class="card" href={s.href}>
            <span class="mono card-meta">{s.meta}</span>
            <span class="card-title">{s.title}</span>
            <span class="card-text">{s.text}</span>
          </a>
        ))
      }
    </section>

    <section class="block" aria-labelledby="protocols">
      <h2 id="protocols">Protocols covered</h2>
      <ul class="protocols">
        {
          protocols.map((p) => (
            <li>
              <a href={url(`projects/?protocol=${encodeURIComponent(p.main)}`)}>
                <span class="mono protocol-code">{p.label}</span>
                {p.name && <span class="protocol-name">{p.name}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="data-flow">
      <h2 id="data-flow">Where the data comes from</h2>
      <p class="intro">
        Nothing is edited on this site. Content is curated in the repository, exported as versioned JSON,
        and built into static pages. No account, API or database sits behind it.
      </p>
      <ol class="steps">
        {
          steps.map((s) => (
            <li>
              <span class="mono step">{s.step}</span>
              <span class="step-title">{s.title}</span>
              <span class="step-text">{s.text}</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="contribute" aria-labelledby="contribute">
      <div>
        <h2 id="contribute">Missing a project or a product?</h2>
        <p>
          Contributions go through the repository. Open an “Add a link” issue or read the contribution
          guide.
        </p>
      </div>
      <a class="button contribute-link" href={CONTRIBUTING_URL}>Contribution guide</a>
    </section>
  </div>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 820px;
    padding: 72px 0 56px;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 54px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0;
    font-size: 19px;
    line-height: 1.55;
    color: var(--color-body-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    text-decoration: none;
  }

  .card:hover {
    border-color: var(--color-accent);
    color: var(--color-ink);
  }

  .card-meta {
    font-size: 13px;
    color: var(--color-muted);
  }

  .card-title {
    font-size: 21px;
    font-weight: 600;
  }

  .card-text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-body-soft);
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: 72px;
  }

  h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .protocols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-line);
  }

  .protocols a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: var(--target-min);
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
  }

  .protocol-code {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-accent);
  }

  .protocol-name {
    font-size: 14px;
    color: var(--color-body-soft);
  }

  .intro {
    max-width: 720px;
    margin: 0;
    line-height: 1.6;
    color: var(--color-body-soft);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    background: var(--color-accent-soft);
    border-radius: var(--radius-md);
  }

  .step {
    font-size: 13px;
    color: var(--color-accent-hover);
  }

  .step-title {
    font-size: 18px;
    font-weight: 600;
  }

  .step-text {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-body);
  }

  .contribute {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 72px;
    padding: 36px;
    background: var(--color-ink);
    color: var(--color-ground);
    border-radius: var(--radius-lg);
  }

  .contribute div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 640px;
  }

  .contribute h2 {
    font-size: 24px;
  }

  .contribute p {
    margin: 0;
    line-height: 1.55;
    color: var(--color-inverse-text);
  }

  .contribute-link {
    background: var(--color-ground);
    color: var(--color-ink);
  }

  .contribute-link:hover {
    background: #ffffff;
    color: var(--color-ink);
  }

  .contribute-link:focus-visible {
    outline-color: var(--color-ground);
  }

  @media (max-width: 600px) {
    .hero {
      padding: 48px 0 40px;
    }

    .contribute {
      padding: 24px;
    }
  }
</style>
