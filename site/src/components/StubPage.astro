---
// Placeholder body for a section whose page is not built yet. Each page that
// uses it is replaced by its own implementation; delete this component once
// none does.
interface Props {
  title: string;
  /** Where the same content can be read in the meantime. */
  fallbackHref: string;
  fallbackLabel: string;
}

const { title, fallbackHref, fallbackLabel } = Astro.props;
---

<div class="container">
  <div class="stub">
    <h1>{title}</h1>
    <p>
      This page is not built yet. Until it is, read it in the repository:
      <a href={fallbackHref}>{fallbackLabel}</a>.
    </p>
  </div>
</div>

<style>
  .stub {
    max-width: 820px;
    padding: 72px 0 24px;
  }

  h1 {
    margin: 0 0 16px;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
    font-size: 17px;
    color: var(--color-body-soft);
  }
</style>
