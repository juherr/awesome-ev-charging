{
  // Lint only the docs this repo authors. The protocol specifications under
  // ocpp/, ocpi/, oicp/, emi3/ and eichrecht/ are vendored upstream reference
  // material — reformatting them would just make them diverge from their source.
  "globs": ["README.md", "CONTRIBUTING.md", "AGENTS.md", "CLAUDE.md", "legacy-projects.md", "csms.md",
            "csms-features.md", "docs/**/*.md", ".github/**/*.md"],

  "config": {
    // README.md and legacy-projects.md are generated by `pipeline.py render`,
    // and the awesome format puts each project on a single line: link,
    // description, then the metadata parenthetical. Wrapping is not an option,
    // so line length carries no signal here.
    "MD013": false,

    // Every protocol section repeats the same subcategory names (Libraries,
    // Server, Simulator, Misc...) and, under Libraries, the same language
    // headings. Those are never siblings, so only flag genuine repeats within a
    // single parent.
    "MD024": { "siblings_only": true },

    // False positive on `### eMI³ (eMobility ICT Interoperability)`: MD051 keeps
    // the `³` when slugging, so it expects `#emi³-emobility-ict-interoperability`.
    // GitHub drops it — `github-slugger` returns
    // `emi-emobility-ict-interoperability`, which is what `_slugify` in
    // pipeline.py emits and what the anchor resolves to on github.com.
    "MD051": false
  }
}
