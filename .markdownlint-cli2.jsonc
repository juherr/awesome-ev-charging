{
  // Lint every Markdown file the repository tracks, first-party files under the
  // vendored directories (ocpp/, emi3/, nemo/, oscp/...) included: they are
  // ours, so they follow our style. markdownlint-cli2 globs with `dot: true`,
  // so `**/*.md` also covers .github/, .claude/ and .agents/.
  "globs": ["**/*.md"],

  "ignores": [
    // Local, untracked trees: agent scratch (and its nested worktrees),
    // the virtualenv, npm installs, the GitHub API cache and pytest's cache.
    ".context/**",
    ".venv/**",
    "node_modules/**",
    "cache_github/**",
    ".pytest_cache/**",

    // Verbatim upstream bytes from the Open Charge Alliance, distributed under
    // the rights holder's terms (see docs/third-party-assets.md). They are never
    // reformatted, so their formatting is not ours to lint. The exemption covers
    // style only: they stay in the provenance and licence inventory of
    // docs/third-party-assets.md. Byte pinning of vendored directories is
    // tracked in https://github.com/juherr/awesome-ev-charging/issues/97.
    // VENDORED_VERBATIM_MARKDOWN in tests/test_markdown_links.py lists the
    // same three files: keep both in step. That test still checks their links.
    "ocpp/OCPP-2.0/ReadMe.md",
    "ocpp/OCPP-2.0.1/ReadMe.md",
    "ocpp/OCPP-2.1/ReadMe.md"
  ],

  "config": {
    // README.md and legacy-projects.md are generated by `pipeline.py render`,
    // and the awesome format puts each project on a single line: link,
    // description, then the metadata parenthetical. Wrapping is not an option,
    // so line length carries no signal here.
    "MD013": false,

    // Every protocol section repeats the same subcategory names (Libraries,
    // Server, Simulator, Misc...) and, under Libraries, the same language
    // headings. Those are never siblings, so only flag genuine repeats within a
    // single parent.
    "MD024": { "siblings_only": true },

    // False positive on `### eMI³ (eMobility ICT Interoperability)`: MD051 keeps
    // the `³` when slugging, so it expects `#emi³-emobility-ict-interoperability`.
    // GitHub drops it — `github-slugger` returns
    // `emi-emobility-ict-interoperability`, which is what `_slugify` in
    // pipeline.py emits and what the anchor resolves to on github.com.
    "MD051": false
  },

  "overrides": [
    {
      // The body of this agent file is the live classifier prompt, sent to the
      // model as is: every byte of it is text the model reads, so it is not
      // reshaped for style. It opens with prose (MD041), shows the output
      // contract with a `<one factual sentence>` placeholder (MD033), and its
      // lists are glued to their labels (`Rules:`, `Categories:`), exactly as
      // the model reads and must answer them (MD032). Only these three rules are relaxed, for this file.
      "filter": [".claude/agents/repo-classifier.md"],
      "config": { "MD032": false, "MD033": false, "MD041": false },
      "combine": "merge"
    }
  ]
}
